<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Olivia's Picturebook</title>

        <!-- Links -->
        <link rel="icon" type="image/x-icon" href="/favicon.ico">
        <link rel="stylesheet" href="/stylesheets/styles.css">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=DynaPuff:wdth,wght@80,400&display=swap" rel="stylesheet">
        <script>window.uploadImage = "<%= uploadImage %>";</script>
        <script src="/scripts/playImages.js"></script>
        <script src="/scripts/upload.js" defer></script>
    </head>

    <body>
        <!-- Section for the upper left back button -->
        <section class="BackButtonLocation">
            <a href="/Olivia's_Picturebook/photo_album"
            class="ToTitle">
            Back to Album
            </a>
        </section>
        
        <!-- Upper half of screen image display section -->
        <section class="ImageLocation">

        </section>

        <!-- Bottom of page input section -->
        <section class="InputLocation">
            <table>
                <thead>
                    <tr>
                        <th>
                            <input id="AlbumPhotoNameInput" spellcheck="false">
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <button id="SaveButton">Save</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </section>
    </body>
</html>
